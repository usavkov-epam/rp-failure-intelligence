# Hosted/production image example. The `:local` image and compose.yaml do not use
# this file. Never use production credentials in a developer environment.

# GitHub OAuth App for http://localhost:8080
# Callback: http://localhost:8080/api/auth/callback/github
APP_MODE=hosted
TEST_RUNNER=github-actions
APP_BASE_URL=http://localhost:8080
AUTH_SECRET=replace-with-a-random-value
AUTH_GITHUB_ID=replace-with-oauth-client-id
AUTH_GITHUB_SECRET=replace-with-oauth-client-secret
AUTHORIZATION_MODE=users
AUTH_ALLOWED_USERS=your-github-login
AUTH_ALLOWED_ORGS=
AUTH_TRUST_HOST=true

# AWS resources created by the CDK stacks. The container can use the normal AWS
# credential chain (for example a read-only-mounted ~/.aws directory) or a task role.
AWS_REGION=us-east-1
AWS_DYNAMODB_TABLE=rp-failure-intelligence
DATA_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
WEB_PUSH_PUBLIC_KEY=replace-with-vapid-public-key

# ReportPortal, TestRail, GitHub Actions/source, and Cypress profiles are configured
# per user from the application's Settings page.
