# Product identity
APP_NAME=Failure intelligence

# GitHub OAuth app: callback URL is https://your-host/api/auth/callback/github
AUTH_SECRET=generate-with-pnpm-exec-auth-secret
AUTH_GITHUB_ID=replace-with-oauth-client-id
AUTH_GITHUB_SECRET=replace-with-oauth-client-secret
AUTHORIZATION_MODE=organization
AUTH_ALLOWED_ORGS=folio-org
AUTH_ALLOWED_USERS=
AUTH_TRUST_HOST=true

# Fine-grained GitHub token with Actions: Read and write for this repository.
GITHUB_ACTIONS_TOKEN=replace-with-actions-write-token
GITHUB_ACTIONS_OWNER=usavkov-epam
GITHUB_ACTIONS_REPO=rp-failure-intelligence
GITHUB_ACTIONS_WORKFLOW=cypress-selected-specs.yml
GITHUB_ACTIONS_REF=main

# Read-only source repository used to link ReportPortal failures to test specs.
GITHUB_SOURCE_OWNER=folio-org
GITHUB_SOURCE_REPO=stripes-testing
GITHUB_SOURCE_REF=master

# Shared, server-only integrations
RP_API_URL=https://report-portal.ci.folio.org/api/v1
RP_API_KEY=replace-with-a-read-only-reportportal-key
TESTRAIL_BASE_URL=https://foliotest.testrail.io
TESTRAIL_API_USER=
TESTRAIL_API_KEY=
JIRA_BASE_URL=https://folio-org.atlassian.net
JIRA_API_KEY=